#include <bits.stdc++.h>
using namespace std;
#define int long long
#define endl '\n'

signed main () {
 int t; cin >> t;
 while (t--) {
  int n; cin >> n;
  int plus = 0, minus = 0;
  for (int i = 0; i < n; i++) {
   int x; cin >> x;
   if (x >= 0) plus++;
   else minus++;
  }
 if (plus > minus) cout << "Positif WIN!" << endl;
 else if (minus > plus) cout << "Negatif WIN!" << endl;
 else cout << "Seri!" << endl;
 }
 return 0;
}
