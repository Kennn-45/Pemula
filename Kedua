#include <bits.stdc++.h>
using namespace std;
#define int long long
#define endl '\n'

signed main () {
 int t; cin >> t;
 while (t--) {
  int n; cin >> n;
  vector<int> angka(n);
  double jumlah = 0;
  for (int i = 0; i < n; i++) {
   cin >> angka[i];
   jumlah += angka[i];
  }
  sort(angka.begin(), angka.end());
  cout << angka[0] << " & " << angka[n-1] << endl;
  cout << "Selisih nilai Max & Min adalah " << abs(angka[0] - angka[n-1]) << endl;
  cout << "Mean baris adalah " << fixed << setprecision(2) << jumlah/n << endl;
 }
 return 0;
}
